<%- include('../partials/head', {title: 'Ternak'}) %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <h1>Ternak<%= category ? ' - ' + category.charAt(0).toUpperCase() + category.slice(1) : '' %></h1>
  <a href="/ternak/new<%= category ? '?category=' + category : '' %>" class="btn btn-success">+ Tambah</a>
</div>
<div class="mb-3">
  <a href="/ternak" class="btn btn-sm btn-outline-secondary <%= !category ? 'active' : '' %>">Semua</a>
  <a href="/ternak?category=ayam" class="btn btn-sm btn-outline-secondary <%= category==='ayam' ? 'active' : '' %>">🐔 Ayam</a>
  <a href="/ternak?category=ikan" class="btn btn-sm btn-outline-secondary <%= category==='ikan' ? 'active' : '' %>">🐟 Ikan</a>
</div>
<table class="table table-hover bg-white">
  <thead><tr><th>Nama</th><th>Kategori</th><th>Jenis</th><th>Jumlah</th><th>Mulai</th><th>Status</th><th></th></tr></thead>
  <tbody>
  <% animals.forEach(a => { %>
    <tr>
      <td><a href="/ternak/<%= a.id %>"><%= a.name %></a></td>
      <td><%= a.category %></td>
      <td><%= a.breed || '-' %></td>
      <td><%= a.quantity %></td>
      <td><%= a.start_date || '-' %></td>
      <td><span class="badge bg-<%= a.status === 'aktif' ? 'success' : 'secondary' %>"><%= a.status %></span></td>
      <td><a href="/ternak/<%= a.id %>/edit" class="btn btn-sm btn-outline-primary">Edit</a></td>
    </tr>
  <% }) %>
  <% if (animals.length === 0) { %>
    <tr><td colspan="7" class="text-center text-muted">Belum ada data.</td></tr>
  <% } %>
  </tbody>
</table>
<%- include('../partials/foot') %>
