<%- include('../partials/head', {title: 'Tambah Transaksi'}) %>
<h1 class="mb-4">Tambah Transaksi</h1>
<form method="POST" action="/keuangan" class="bg-white p-4 rounded shadow-sm">
  <div class="mb-3">
    <label class="form-label">Terkait dengan (opsional)</label>
    <select name="ref_select" class="form-select" onchange="
      const [type, id] = this.value.split(':');
      document.getElementById('ref_type').value = type || '';
      document.getElementById('ref_id').value = id || '';
    ">
      <option value=":">Umum (tidak terkait)</option>
      <optgroup label="Ternak">
        <% animals.forEach(a => { %><option value="animal:<%= a.id %>">🐔 <%= a.name %> (<%= a.category %>)</option><% }) %>
      </optgroup>
      <optgroup label="Kebun">
        <% plants.forEach(p => { %><option value="plant:<%= p.id %>">🌱 <%= p.name %></option><% }) %>
      </optgroup>
    </select>
    <input type="hidden" name="ref_type" id="ref_type">
    <input type="hidden" name="ref_id" id="ref_id">
  </div>
  <div class="mb-3"><label class="form-label">Tanggal</label><input type="date" name="trans_date" class="form-control" required value="<%= new Date().toISOString().slice(0,10) %>"></div>
  <div class="mb-3">
    <label class="form-label">Tipe</label>
    <select name="type" class="form-select" required>
      <option value="pengeluaran">Pengeluaran</option>
      <option value="pemasukan">Pemasukan</option>
    </select>
  </div>
  <div class="mb-3"><label class="form-label">Kategori</label><input type="text" name="category" class="form-control" placeholder="misal: Pakan, Bibit, Hasil panen"></div>
  <div class="mb-3"><label class="form-label">Jumlah (Rp)</label><input type="number" name="amount" class="form-control" required min="0"></div>
  <div class="mb-3"><label class="form-label">Catatan</label><textarea name="notes" class="form-control" rows="2"></textarea></div>
  <button class="btn btn-success" type="submit">Simpan</button>
  <a href="/keuangan" class="btn btn-outline-secondary">Batal</a>
</form>
<%- include('../partials/foot') %>
