<%- include('../partials/head', {title: 'Keuangan'}) %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <h1>Keuangan</h1>
  <a href="/keuangan/new" class="btn btn-success">+ Tambah Transaksi</a>
</div>
<form method="GET" class="mb-3">
  <input type="month" name="month" value="<%= month %>" class="form-control d-inline-block w-auto" onchange="this.form.submit()">
</form>
<div class="row g-3 mb-3">
  <div class="col-md-4"><div class="card text-center"><div class="card-body"><div class="fs-5 text-success">+<%= formatCurrency(totals.income) %></div><div class="text-muted">Pemasukan</div></div></div></div>
  <div class="col-md-4"><div class="card text-center"><div class="card-body"><div class="fs-5 text-danger">-<%= formatCurrency(totals.expense) %></div><div class="text-muted">Pengeluaran</div></div></div></div>
  <div class="col-md-4"><div class="card text-center"><div class="card-body"><div class="fs-5 fw-bold">=<%= formatCurrency(totals.income - totals.expense) %></div><div class="text-muted">Saldo</div></div></div></div>
</div>
<table class="table table-sm bg-white">
  <thead><tr><th>Tanggal</th><th>Tipe</th><th>Kategori</th><th>Terkait</th><th>Jumlah</th><th>Catatan</th><th></th></tr></thead>
  <tbody>
  <% rows.forEach(f => { %>
    <tr>
      <td><%= f.trans_date %></td>
      <td><span class="badge bg-<%= f.type === 'pemasukan' ? 'success' : 'danger' %>"><%= f.type %></span></td>
      <td><%= f.category || '-' %></td>
      <td><%= f.label %></td>
      <td><%= formatCurrency(f.amount) %></td>
      <td><%= f.notes || '-' %></td>
      <td>
        <form method="POST" action="/keuangan/<%= f.id %>?_method=DELETE" onsubmit="return confirm('Hapus?');">
          <button class="btn btn-sm btn-outline-danger">Hapus</button>
        </form>
      </td>
    </tr>
  <% }) %>
  <% if (rows.length === 0) { %><tr><td colspan="7" class="text-center text-muted">Belum ada transaksi bulan ini.</td></tr><% } %>
  </tbody>
</table>
<%- include('../partials/foot') %>
