<%- include('../partials/head', {title: 'Kebun'}) %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <h1>Kebun</h1>
  <a href="/kebun/new" class="btn btn-success">+ Tambah Tanaman</a>
</div>
<table class="table table-hover bg-white">
  <thead><tr><th>Nama</th><th>Varietas</th><th>Jumlah/Luas</th><th>Tanggal Tanam</th><th>Status</th><th></th></tr></thead>
  <tbody>
  <% plants.forEach(p => { %>
    <tr>
      <td><a href="/kebun/<%= p.id %>"><%= p.name %></a></td>
      <td><%= p.variety || '-' %></td>
      <td><%= p.quantity || '-' %></td>
      <td><%= p.planting_date || '-' %></td>
      <td><span class="badge bg-<%= p.status === 'tumbuh' ? 'success' : (p.status === 'panen' ? 'primary' : 'secondary') %>"><%= p.status %></span></td>
      <td><a href="/kebun/<%= p.id %>/edit" class="btn btn-sm btn-outline-primary">Edit</a></td>
    </tr>
  <% }) %>
  <% if (plants.length === 0) { %><tr><td colspan="6" class="text-center text-muted">Belum ada data.</td></tr><% } %>
  </tbody>
</table>
<%- include('../partials/foot') %>
